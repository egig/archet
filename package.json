{
  "name": "@egig/ratchet",
  "version": "0.1.0",
  "description": "Model driven application framework: TypeScript models -> Postgres schema, codegen, and composable pipelines.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ratchet": "./dist/cli/bin.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js",
    "./router": "./dist/router/index.js",
    "./auth": "./dist/auth/index.js",
    "./auth/console-forms": "./dist/auth/console-forms.js",
    "./automation": "./dist/automation/index.js",
    "./workspace": "./dist/workspace/index.js",
    "./console": "./dist/console/index.js",
    "./console/client": "./dist/console/client/index.js",
    "./console/node": "./dist/console/node-assets.js",
    "./storage/node": "./dist/core/storage-node.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "cli": "cd example && bun ../src/cli/bin.ts",
    "serve": "cd example && bun ../src/cli/bin.ts serve",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-data-stream": "^0.12.28",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^1.13.7",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.102.4",
    "assistant-stream": "^0.3.40",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "openai": "^7.5.0",
    "postgres": "^3.4.5",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
